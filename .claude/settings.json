{
  "skillOverrides": {
    "stella": "off",
    "release": "off",
    "probe": "off",
    "autonomous-dev": "off",
    "jsf-mode": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/skills/release/scripts/guard.py pretooluse",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins",
        "sparsePaths": [
          ".claude-plugin",
          "harness/pstack"
        ]
      }
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  }
}
